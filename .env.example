# Copy to .env and fill in. Never commit .env. Never put real values in THIS file.
# Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=
# Right-click the server icon (Developer Mode on) -> Copy Server ID
GUILD_ID=
# 1 = log every role change / post instead of doing it
ARCBOT_DRY_RUN=0
# Optional overrides
# ARCBOT_DB=data/arcbot.db
# ARCBOT_CONFIG=config/arcbot.yaml
# ARCBOT_COPY=config/copy.yaml
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
