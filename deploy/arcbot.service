[Unit]
Description=arcbot Discord bot (The Raider's Outpost)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=arcbot
Group=arcbot
WorkingDirectory=/opt/arcbot/app
EnvironmentFile=/opt/arcbot/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/arcbot/venv/bin/python -m arcbot
Restart=always
RestartSec=5
# hardening that does not get in the way
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/arcbot/app/data

[Install]
WantedBy=multi-user.target
