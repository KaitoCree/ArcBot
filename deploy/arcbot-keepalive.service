[Unit]
Description=arcbot keepalive (memory hold, optional CPU burst) against Always Free idle reclamation
After=network-online.target

[Service]
Type=simple
User=arcbot
Group=arcbot
WorkingDirectory=/opt/arcbot/app
ExecStart=/opt/arcbot/venv/bin/python -m arcbot.services.keepalive
Nice=19
CPUWeight=1
IOSchedulingClass=idle
# exits 0 when disabled in config; only restart on crashes
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/arcbot/app/data

[Install]
WantedBy=multi-user.target
